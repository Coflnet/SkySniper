<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateProgramFile>false</GenerateProgramFile>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
    <!-- Local default: skip the heavy fuzz/parity/bit-exact suite so bare `dotnet test` is fast.
         CI overrides this via ci.runsettings on the dotnet test command line (see Dockerfile) to run everything. -->
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)test.runsettings</RunSettingsFilePath>
  </PropertyGroup>
  <PropertyGroup>
    <!-- benchmarks/ is a separate console project (SkySniper.Benchmarks) that references this one; keep its sources out of the web app's compile. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Client\**\*;benchmarks\**\*</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../dev/hypixel.csproj" />
  </ItemGroup>

  <!--
    The AI finder (model, training, feature extraction, flip rule) lives in the separate SkyAIFinder repository.
    With it checked out next to this one the build includes it and defines AI_FINDER; without it the service builds
    and runs with NoAiFinder (no AI flips). Services/AiFinder/ holds everything that needs its types.
  -->
  <PropertyGroup Condition="Exists('../SkyAIFinder/SkyAIFinder.csproj')">
    <HasAiFinder>true</HasAiFinder>
    <DefineConstants>$(DefineConstants);AI_FINDER</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(HasAiFinder)' == 'true'">
    <ProjectReference Include="../SkyAIFinder/SkyAIFinder.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(HasAiFinder)' != 'true'">
    <Compile Remove="Services\AiFinder\**\*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the benchmark project measure the internal hot-path method ComparisonValue directly. -->
    <InternalsVisibleTo Include="SkySniper.Benchmarks" />
    <InternalsVisibleTo Include="SkyBFCS" />
  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.104.6" />
    <PackageReference Include="Coflnet.Core" Version="0.7.9" />
    <PackageReference Include="Coflnet.Sky.FlipTracker.Client" Version="0.17.0" />
    <PackageReference Include="Coflnet.Sky.Mayor.Client" Version="0.5.0" />
    <PackageReference Include="JWT" Version="11.1.0" />
    <PackageReference Include="Coflnet.Sky.Crafts.Client" Version="0.14.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <Compile Remove="**\*.Tests.cs" />
    <!-- Shared test-support fuzz generator (used only by the *.Tests.cs harnesses); not part of the shipped service. -->
    <Compile Remove="Services\AuctionKeyFuzz.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' != 'Release'">
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
  </ItemGroup>
</Project>
